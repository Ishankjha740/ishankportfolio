# Copy to .env for local dev. On Lovable, .env is auto-generated from the
# Supabase / Lovable Cloud connection — you do not need to edit it manually.
#
# These two values are PUBLIC by design (they ship in the browser bundle).
# Row Level Security is what protects your data. The service_role key is
# never placed here and is not accessible in client code.

VITE_SUPABASE_PROJECT_ID=your_project_ref_here
VITE_SUPABASE_URL=https://your_project_ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key_here